	je .Lfin
	movzx r8d, byte ptr [rcx+2]
	shl r8d, 16
	add eax, r8d
.Lfin:
	imul eax, eax, -962287725
	mov r8d, eax
	shr r8d, 24
	xor eax, r8d
.Ldone:
	ret
"""

