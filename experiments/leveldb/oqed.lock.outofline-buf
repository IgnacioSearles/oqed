asm = """
	imul eax, esi, -962287725
	xor eax, edx
	mov rcx, rdi
	mov r8, rsi
	shr r8, 2
	and esi, 3
	test r8, r8
	jz .Ltail
.Lloop:
	add eax, dword ptr [rcx]
